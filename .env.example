# Environment variables for Traefik gateway
# Copy this file to .env and fill in your values

# Your domain name (without subdomain)
DOMAIN=your.domain

# Cloudflare API credentials
# Get these from https://dash.cloudflare.com/profile/api-tokens
# Option 1: Use API Token (recommended)
CF_API_EMAIL=your-email@example.com
CF_DNS_API_TOKEN=your-cloudflare-api-token

# Option 2: Use API Key (legacy)
# CF_API_EMAIL=your-email@example.com
# CF_API_KEY=your-cloudflare-global-api-key

# Let's Encrypt email for certificate notifications
LETSENCRYPT_EMAIL=your-email@example.com

# Traefik dashboard authentication
# Generate with: echo $(htpasswd -nb admin yourpassword) | sed -e s/\\$/\\$\\$/g
# Default is admin:admin (change this!)
TRAEFIK_DASHBOARD_USERS=admin:$$apr1$$8EVjn/nj$$GiLUZqcbueTFeD23SuB6x0
